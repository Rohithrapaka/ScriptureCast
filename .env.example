# ── ScriptureCast environment variables ──────────────────────────────────────
# Copy this file to .env and fill in the values before running in production.
# In development the defaults work without a .env file.

# ── Required ──────────────────────────────────────────────────────────────────

# Port the Express server listens on.
# Render uses 10000, Railway auto-assigns, Docker/VPS use whatever you want.
PORT=3000

# Set to "production" for production deployments.
NODE_ENV=production

# ── Optional ──────────────────────────────────────────────────────────────────

# PostgreSQL connection string.
# Currently optional — Bible data loads from JSON files and presentation state
# is in-memory.  Set this if you add persistent storage (user settings, etc.).
# DATABASE_URL=postgresql://user:password@host:5432/scripture_cast

# Session secret used for signing cookies/sessions (if auth is added later).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET=

# JWT secret for signing authentication tokens. Use a strong random string.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# JWT_SECRET=

# JWT token lifetime. Examples: "7d", "24h", "30m". Defaults to "7d".
# JWT_EXPIRES_IN=7d

# bcrypt cost factor (4–31). Higher = slower hash + more secure.
# 10 is safe for most servers; use 12 on high-spec production hardware.
# BCRYPT_ROUNDS=10

# Base URL path prefix (default: "/").
# Only needed when hosting behind a sub-path reverse proxy.
BASE_PATH=/
